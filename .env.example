GERSTEP_ORIGIN=https://167.86.106.105
GERSTEP_PORT=9081
GERSTEP_DB=/opt/gerstep-interactive/data/interactive.sqlite3
# The installer generates these independently; do not reuse them.
GERSTEP_SESSION_SECRET=
GERSTEP_BRIDGE_TOKEN=
GERSTEP_ADMIN_TOKEN=
GERSTEP_ADMIN_PASSWORD_HASH=
# Optional VPS intake; off while the desktop bridge is connected.
GERSTEP_COLLECT_TIKTOK=0
GERSTEP_TIKTOK_USERNAME=gerstep_official
# Private admin AI tests; menu option 9 stores a key with mode 0600.
# No key is shipped to the frontend or imported from the desktop automatically.
NVIDIA_API_KEY=
GERSTEP_AI_ENABLED=true
GERSTEP_AI_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
GERSTEP_AI_REQUESTS_PER_MINUTE=6
GERSTEP_AI_RESERVED_REQUESTS=0
GERSTEP_AI_TOKENS_PER_MINUTE=12000
GERSTEP_AI_CONCURRENCY=1
GERSTEP_AI_THINKING=false
